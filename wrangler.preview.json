{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abu-mustafa-cost-preview",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "node scripts/build-worker.mjs --config wrangler.preview.json"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/index.html",
      "/admin",
      "/admin/*",
      "/api/*",
      "/products/*",
      "/categories/*",
      "/news/*",
      "/media/*",
      "/catalog.json",
      "/products.json",
      "/catalog.csv",
      "/sitemap.xml",
      "/llms.txt",
      "/robots.txt",
      "/site.webmanifest",
      "/google423f0fde26d818a9.html",
      "/report.html",
      "/research-bundle.zip",
      "/image-manifest.json"
    ],
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abu-mustafa-cost-preview-catalog",
      "database_id": "0460986f-42b9-4d53-9703-7e9e93fa19e8",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "abu-mustafa-cost-preview-photos"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://abu-mustafa-cost-preview.abumustafacenter.workers.dev",
    "PUBLIC_INDEXING": "disabled",
    "ACCESS_TEAM_DOMAIN": "https://still-heart-472a.cloudflareaccess.com",
    "ACCESS_AUD": "87d3b71b41f28fac9a645cf211d08b3e5938f5e46c4c64afaf1901dd83916486"
  }
}
