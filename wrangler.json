{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "abu-mustafa-cloudflare",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "preview_urls": false,
  "build": {
    "command": "node scripts/build-worker.mjs"
  },
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "abu-mustafa-cloudflare-catalog",
      "database_id": "033a633e-1d39-4f26-aecf-2a333d4602ef",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "abu-mustafa-cloudflare-photos"
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://abu-mustafa-cloudflare.abumustafacenter.workers.dev",
    "PUBLIC_INDEXING": "disabled",
    "ACCESS_TEAM_DOMAIN": "https://still-heart-472a.cloudflareaccess.com",
    "ACCESS_AUD": "31b1f5fda375dbdb20939353e8e3abcd1857770045d186ca05b8bdedd9338b8c"
  }
}
